{
  "name": "creeba-expo",
  "version": "0.1.0",
  "description": "iroh P2P transport for Expo/React Native: native module (Swift/Kotlin via iroh-ffi) implementing creeba-js's SyncTransport. Interoperates with desktop and Elysia (same ALPN, wire format and mDNS discovery).",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "ios",
    "android",
    "plugin",
    "app.plugin.js",
    "expo-module.config.json"
  ],
  "scripts": {
    "lint": "tsc --noEmit",
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "test": "node internal/module_scripts/test.js",
    "open:ios": "node internal/module_scripts/open-ios.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "creeba",
    "iroh",
    "expo",
    "react-native",
    "p2p"
  ],
  "repository": "https://github.com/DATAGNIKAN/creeba.git",
  "bugs": {
    "url": "https://github.com/DATAGNIKAN/creeba/issues"
  },
  "author": "DATAGNI K. Armand Noël <datagni.k.armand.n@gmail.com> (DATAGNIKAN)",
  "license": "MIT",
  "homepage": "https://github.com/DATAGNIKAN/creeba#readme",
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*",
    "creeba-js": "*"
  },
  "peerDependenciesMeta": {
    "creeba-js": { "optional": true }
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "expo": "~57.0.4",
    "expo-modules-core": "~3.0.0",
    "typescript": "~6.0.3",
    "creeba-js": "link:creeba-js"
  }
}
