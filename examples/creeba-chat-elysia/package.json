{
  "name": "creeba-chat-elysia",
  "version": "0.1.1",
  "description": "Creeba P2P node served by Elysia (Bun): CreebaSync + iroh/mDNS transport + local bun:sqlite database, exposed to a web client via WebSocket.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts"
  },
  "dependencies": {
    "@number0/iroh": "^1.0.0",
    "bonjour-service": "^1.4.3",
    "elysia": "latest",
    "@streamline-pulse/creeba-core": "workspace:*",
    "@streamline-pulse/creeba-iroh-mdns": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
