{
  "name": "creeba-chat-electrobun",
  "version": "0.1.8",
  "description": "Desktop P2P chat (Electrobun + Bun): local DuckDB database, iroh (QUIC) transport and local mDNS discovery.",
  "scripts": {
    "start": "vite build && electrobun dev",
    "dev": "electrobun dev --watch",
    "dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
    "hmr": "vite --port 5173",
    "build:canary": "vite build && electrobun build --env=canary",
    "build:stable": "vite build && electrobun build --env=stable"
  },
  "dependencies": {
    "@duckdb/node-api": "latest",
    "@number0/iroh": "^1.0.0",
    "bonjour-service": "^1.4.3",
    "electrobun": "1.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@streamline-pulse/creeba-core": "workspace:*",
    "@streamline-pulse/creeba-iroh-mdns": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
